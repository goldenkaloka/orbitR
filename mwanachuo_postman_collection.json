									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"restaurant\": \"RESTAURANT_ID_HERE\",\n    \"items\": [\n        {\n            \"product\": \"PRODUCT_ID_HERE\",\n            \"quantity\": 2\n        }\n    ],\n    \"delivery_address\": \"Hostel Block A, Room 101\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/orders/",
