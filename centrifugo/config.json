{
  "engine": {
    "type": "redis",
    "redis": {
      "address": ""
    }
  },
  "client": {
    "token": {
      "hmac_secret_key": ""
    },
    "allowed_origins": [
      "https://mwanachuoshop.com",
      "https://api.mwanachuoshop.com"
    ]
  },
  "http_api": {
    "key": ""
  },
  "admin": {
    "enabled": true,
    "password": "",
    "secret": ""
  },
  "channel": {
    "proxy": {
      "subscribe": {
        "endpoint": "http://backend:8000/api/ws-subscribe-check/",
        "timeout": "10s",
        "http": {
          "static_headers": {
            "X-Centrifugo-Proxy-Secret": "${CENTRIFUGO_VAR_PROXY_SECRET}"
          }
        }
      }
    },
    "namespaces": [
      {
        "name": "orders",
        "history_size": 50,
        "history_ttl": "300s",
        "presence": true,
        "join_leave": true,
        "force_recovery": true,
        "subscribe_proxy_enabled": true
      },
      {
        "name": "pools",
        "history_size": 50,
        "history_ttl": "300s",
        "presence": true,
        "join_leave": true,
        "force_recovery": true,
        "subscribe_proxy_enabled": true
      },
      {
