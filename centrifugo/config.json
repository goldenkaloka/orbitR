        "force_recovery": true,
        "subscribe_proxy_enabled": true
      },
      {
        "name": "vendors",
        "history_size": 10,
        "history_ttl": "120s",
        "presence": false,
        "force_recovery": true,
        "subscribe_proxy_enabled": true
      },
      {
        "name": "riders",
