# Database Configuration
DB_NAME=mwanachuo_db
DB_USER=mwanachuo_user
DB_PASSWORD=mwanachuo_password
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# MinIO / S3 Configuration
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_STORAGE_BUCKET_NAME=static
MINIO_ENDPOINT=http://localhost:9000

# Payment Gateways (AirPay)
AIRPAY_MERCHANT_ID=
AIRPAY_USERNAME=
AIRPAY_PASSWORD=
AIRPAY_SECRET=
AIRPAY_CLIENT_ID=
AIRPAY_CLIENT_SECRET=
AIRPAY_SECRET_KEY=
AIRPAY_SANDBOX=True
AIRPAY_MOCK=True

# Notifications
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# SMS Gateway (Infobip)
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_SENDER_ID=InfoSMS
MOCK_SMS=True

# Django Security
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*
