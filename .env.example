# Database Configuration
DB_NAME=mwanachuo_db
DB_USER=mwanachuo_user
DB_PASSWORD=mwanachuo_password
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_CONCURRENCY=2
CELERY_PAYMENTS_CONCURRENCY=1
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=200
CELERY_RESULT_EXPIRES=3600

# MinIO / S3 Configuration
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_STORAGE_BUCKET_NAME=static
MINIO_ENDPOINT=http://localhost:9000

# Payment Gateways (AirPay)
AIRPAY_MERCHANT_ID=
AIRPAY_USERNAME=
AIRPAY_PASSWORD=
AIRPAY_SECRET=
AIRPAY_CLIENT_ID=
AIRPAY_CLIENT_SECRET=
AIRPAY_SECRET_KEY=
AIRPAY_SANDBOX=True
AIRPAY_MOCK=True

# Notifications
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# SMS Gateway (RafikiSMS)
RAFIKI_API_KEY=sk_your_api_key_here
RAFIKI_SENDER_NAME=YourSenderName
MOCK_SMS=True

# Django Security
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
PERF_SLOW_REQUEST_MS=700
PERF_REQUEST_LOG_LEVEL=WARNING
PERF_CELERY_LOG_LEVEL=INFO

# Production reverse-proxy/TLS example (api.mwanachuoshop.com)
# DEBUG=False
# ALLOWED_HOSTS=api.mwanachuoshop.com
# CSRF_TRUSTED_ORIGINS=https://api.mwanachuoshop.com
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# MINIO_ENDPOINT=http://minio:9000
# MINIO_EXTERNAL_URL=https://api.mwanachuoshop.com
# MINIO_STORAGE_BUCKET_NAME=media
