# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=mwanachuo_db
POSTGRES_USER=mwanachuo_user
POSTGRES_PASSWORD=mwanachuo_password
DB_NAME=mwanachuo_db
DB_USER=mwanachuo_user
DB_PASSWORD=mwanachuo_password
DB_HOST=localhost
DB_PORT=5432

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=mwanachuo_redis
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6379/1
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@127.0.0.1:6379/0
CELERY_CONCURRENCY=2
CELERY_PAYMENTS_CONCURRENCY=1
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=200
CELERY_RESULT_EXPIRES=3600

# ── MinIO / S3 ─────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_STORAGE_BUCKET_NAME=static
MINIO_ENDPOINT=http://localhost:9000
MINIO_EXTERNAL_URL=http://localhost:9000

# ── AirPay (Payment Gateway) ───────────────────────────────────────────────
AIRPAY_MERCHANT_ID=
AIRPAY_USERNAME=
AIRPAY_PASSWORD=
AIRPAY_SECRET=
AIRPAY_CLIENT_ID=
AIRPAY_CLIENT_SECRET=
AIRPAY_SECRET_KEY=
AIRPAY_MERCHANT_DOMAIN=mwanachuoshop.com
AIRPAY_SPLIT_API_KEY=
AIRPAY_PRIMARY_ACCOUNT=
AIRPAY_SANDBOX=True
AIRPAY_MOCK=True
AIRPAY_ALLOW_UNSIGNED_WEBHOOKS=False
TRUST_PROXY_HEADERS=False
LOCAL_PICKUP_MAX_DISTANCE_KM=0.5
DRIVER_RESTAURANT_MAX_DISTANCE_KM=5.0
DRIVER_RESTAURANT_ZONE_RADIUS=0
JWT_ACCESS_TOKEN_HOURS=168
JWT_REFRESH_TOKEN_DAYS=3650
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True

# ── Mapbox (Route geometry pre-fetching) ──────────────────────────────────
# Must be named MAPBOX_TOKEN — this is what the backend code reads.
# (Not MAPBOX_ACCESS_TOKEN — that name is ignored.)
MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# ── OneSignal (Push Notifications) ─────────────────────────────────────────
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ── RafikiSMS (SMS Gateway) ────────────────────────────────────────────────
RAFIKI_API_KEY=sk_your_api_key_here
RAFIKI_SENDER_NAME=YourSenderName
MOCK_SMS=True

# ── Database Backup (pg_dump + rclone) ──────────────────────────────────────
# rclone remote path, e.g. "gdrive:orbit-backups"
# Configure rclone first: rclone config (set up Google Drive as "gdrive")
RCLONE_REMOTE=
# Directory for local backup files before upload
DB_BACKUP_DIR=backups
# Number of backups to keep on remote (older ones are auto-deleted)
DB_BACKUP_MAX_KEEP=7

# ── Centrifugo (WebSocket) ─────────────────────────────────────────────────
CENTRIFUGO_HMAC_SECRET=change-me-to-a-random-64-char-hex-string
CENTRIFUGO_API_KEY=change-me-to-another-random-64-char-hex-string
CENTRIFUGO_ADMIN_PASSWORD=change-me-to-admin-password
CENTRIFUGO_ADMIN_SECRET=change-me-to-admin-jwt-secret
CENTRIFUGO_API_URL=http://centrifugo:8000

# ── Django Security ────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
PERF_SLOW_REQUEST_MS=700
PERF_REQUEST_LOG_LEVEL=WARNING
PERF_CELERY_LOG_LEVEL=INFO

# ── Production example (api.mwanachuoshop.com) ─────────────────────────────
# Uncomment and adjust when deploying:
# DEBUG=False
# ALLOWED_HOSTS=api.mwanachuoshop.com,178.105.46.108,backend
# Note: 'backend' is required so Centrifugo's subscribe proxy can call Django
# internally via http://backend:8000 without triggering DisallowedHost errors.
# CSRF_TRUSTED_ORIGINS=https://api.mwanachuoshop.com
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# MINIO_ENDPOINT=http://minio:9000
# MINIO_EXTERNAL_URL=https://api.mwanachuoshop.com
# MINIO_STORAGE_BUCKET_NAME=media
